# Copy this file to .env and fill in your own values. Never commit .env.
SPANNER_EMULATOR_HOST="localhost:9010"
SPANNER_PROJECT="PROJECT_ID"
SPANNER_INSTANCE="omni-instance"
SPANNER_DATABASE="pickleball-db"
# Gemini key is OPTIONAL here. Without it (or with COACH_MODE=local) the app
# coaches from Spanner data via the local coach. Put your own key here only
# if you want Gemini answers; never paste anyone else's key.
GEMINI_API_KEY="REPLACE_WITH_YOUR_ACTUAL_GEMINI_KEY"
# auto = Gemini when available, local coach otherwise (default).
# local = never call Gemini; coach purely from Spanner data.
COACH_MODE="auto"
